# Полный контракт переменных окружения prod-инстанса (docker-compose.prod.yml).
# Скопируйте в .env.prod на сервере; файл .env.prod в git не коммитится.
# Новый инстанс удобнее создавать скриптом: scripts/onboarding/new-instance.sh
# (сам генерирует секреты). Штатный деплой ВАШИХ test/prod перезаписывает
# .env.prod из GitHub Environment (ADR 0001) — клиентские инстансы деплоятся
# без Actions, там этот файл живёт на сервере.
#
# ПРАВИЛО: добавили чтение новой переменной окружения в код — в том же коммите
# допишите её сюда (и в backend/.env.example, если она backend-локальная).

# ── Обязательные ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGEME
# Минимум 32 символа (backend/config.py).
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# База API для frontend-сборки; за nginx на том же домене — относительный /api.
VITE_API_BASE_URL=/api

# ── Опциональные: параметры инстанса (несколько систем на одном VPS) ─────────
# new-instance.sh заполняет их сам; без них — поведение прежнего одиночного prod.
# Имя compose-проекта: изолирует тома (данные БД!) и сети между инстансами.
# WMS_INSTANCE=wms-prod
# Префикс имён контейнеров (латиница/цифры/подчёркивание).
# WMS_CONTAINER_PREFIX=wms_prod
# Loopback-порты backend/frontend; у каждого инстанса на сервере — свои.
# WMS_BACKEND_PORT=10000
# WMS_FRONTEND_PORT=10080

# ── Опциональные: сеть и безопасность ────────────────────────────────────────
# Явный список CORS-origins через запятую (prod fail-closed: без него origins
# выводятся из VITE_API_BASE_URL + localhost-origins мобильного приложения).
# CORS_ALLOW_ORIGINS=https://app.client.ru,http://localhost
# Доверенные reverse-proxy (тогда учитывается X-Forwarded-For): IP, CIDR, имя хоста.
# TRUSTED_PROXIES=172.18.0.0/16
# Redis для rate-limit /auth/login (IP+email); без него — in-memory только по IP.
# REDIS_URL=redis://127.0.0.1:6379/0

# ── Опциональные: фоновые циклы ──────────────────────────────────────────────
# Авто-начисления (ЗП, аренда, регулярные расходы); 0 — выключить. По умолчанию 1.
# SALARY_SCHEDULER=1
# Push-уведомления «Новая задача» (FCM); 0 — выключить. По умолчанию 1.
# PUSH_SCHEDULER=1
# Ключ сервисного аккаунта Firebase для FCM (путь внутри контейнера backend).
# Без него push-цикл неактивен — для инстанса без мобильных пушей это норма.
# FIREBASE_CREDENTIALS_FILE=/app/secrets/firebase.json
# PUSH_STORM_THRESHOLD=20
# Синк FBS-заказов маркетплейсов (Ozon/WB); 0 — выключить (инстанс без FBS). По умолчанию 1.
# MP_SCHEDULER=1
# Интервал polling'а заказов, сек (минимум 30). По умолчанию 120.
# MP_SYNC_INTERVAL_SECONDS=120
# Расчётный SLA сборки WB, часов (WB не отдаёт дедлайн в API). По умолчанию 24.
# MP_WB_SLA_HOURS=24
# Выгрузка остатков WMS → маркетплейс (пока только WB); 0 — выключить. По умолчанию 1.
# MP_STOCK_SCHEDULER=1
# Интервал выгрузки остатков, сек (минимум 60). По умолчанию 300.
# MP_STOCK_PUSH_INTERVAL_SECONDS=300
# Авто-перевод отгрузок «Ожидание упаковки» → «Подготовка» по готовности остатка; 0 — выключить. По умолчанию 1.
# DISPATCH_AUTOPROMOTE_SCHEDULER=1

# ── Опциональные: прочее ─────────────────────────────────────────────────────
# Путь на хосте для загрузок (фото товаров, вложения); bind-mount в /app/uploads.
# По умолчанию /var/www/app-prod/uploads (см. docker-compose.prod.yml).
# WAREHOUSE_UPLOADS_HOST_PATH_PROD=/var/www/app-prod/uploads
# Версия для GET /version (CI подставляет SHA, new-instance.sh — git describe).
# APP_VERSION=v1.0.1
# Заголовок вкладки браузера (build-arg frontend; по умолчанию Pack-men).
# VITE_APP_TITLE=Pack-men
# Уровень логирования backend (INFO по умолчанию).
# LOG_LEVEL=INFO
# APP_ENV=prod
