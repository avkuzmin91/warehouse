# Скопируйте в .env.prod на сервере; файл .env.prod в git не коммитится.
# docker-compose.prod.yml подставляет ${POSTGRES_PASSWORD} и ${VITE_API_BASE_URL} через --env-file .env.prod
# (штатный деплой перезаписывает .env.prod из GitHub Environment «production»).
POSTGRES_PASSWORD=CHANGEME
VITE_API_BASE_URL=/api
# Минимум 32 символа (backend/config.py). В CI — секрет JWT_SECRET.
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# Версия для GET /version: deploy.sh подставляет git describe; переопределение: APP_VERSION=...
# APP_ENV=prod
