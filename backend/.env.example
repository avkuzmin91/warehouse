# Скопируйте в .env и при необходимости поправьте.
# Символ # в пароле в URL должен быть закодирован как %23.
DATABASE_URL=postgresql://postgres:CHANGEME@127.0.0.1:5432/wms
# Минимум 32 символа (config.py).
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# Версия для GET /version: локально — git describe из репо; в Docker без .git задайте APP_VERSION или см. deploy.sh.
# APP_ENV=dev
# APP_VERSION=v1.0.1
# Redis для rate limit POST /auth/login (IP + email); см. backend/docs/auth-rate-limit.md
# Доверенный reverse proxy: только тогда учитывается X-Forwarded-For (иначе — peer TCP).
# Список через запятую: IP, CIDR, имя хоста peer (например nginx в Docker network).
# TRUSTED_PROXIES=127.0.0.1,nginx,172.18.0.0/16
# REDIS_URL=redis://127.0.0.1:6379/0
# AUTH_LOGIN_RL_REDIS_DISABLED=0
# AUTH_LOGIN_RL_IP_MAX=10
# AUTH_LOGIN_RL_IP_WINDOW_SEC=60
# AUTH_LOGIN_RL_EMAIL_MAX=8
# AUTH_LOGIN_RL_EMAIL_WINDOW_SEC=600
# AUTH_LOGIN_RL_MAX_BODY_BYTES=32768
# AUTH_LOGIN_RL_FAIL_CLOSED=0
# Таймауты Redis (иначе при недоступном Redis первый login может ждать TCP очень долго):
# AUTH_LOGIN_RL_REDIS_SOCKET_CONNECT_TIMEOUT_SEC=2
# AUTH_LOGIN_RL_REDIS_SOCKET_TIMEOUT_SEC=2
# Таймаут закрытия клиента Redis в middleware (защита от зависания → 502 у nginx).
# AUTH_LOGIN_RL_REDIS_CLOSE_TIMEOUT_SEC=3
# Без REDIS_URL: login — in-memory только по IP; те же пороги:
# AUTH_RATE_LIMIT_LOGIN_MAX=20
# AUTH_RATE_LIMIT_LOGIN_WINDOW_SEC=60
# POST /auth/refresh — in-memory, per IP:
# AUTH_RATE_LIMIT_REFRESH_MAX=60
# AUTH_RATE_LIMIT_REFRESH_WINDOW_SEC=60
# POST /auth/register — in-memory, per IP:
# AUTH_RATE_LIMIT_REGISTER_MAX=5
# AUTH_RATE_LIMIT_REGISTER_WINDOW_SEC=60
# Повтор старого refresh после ротации: отзыв всех сессий пользователя, если прошло ≥ N сек (см. AUTH_REPLAY_REVOKE_MIN_SECONDS).
# AUTH_REPLAY_REVOKE_MIN_SECONDS=30
# Лимит записей in-memory denylist для jti после logout (PR6).
# AUTH_JTI_DENYLIST_MAX=5000
# Prod: список origin через запятую (credentials; без *). Пусто — regex localhost для dev.
# Для нативного мобильного клиента (Capacitor, Android) добавить его origin:
#   Android = http://localhost
# CORS_ALLOW_ORIGINS=https://app.example.com,http://localhost
# Каталог загрузок (фото товаров, import staging). Без Docker: папка backend/uploads рядом с main.py.
# Docker dev: корень репозитория uploads/ (см. docker-compose.dev.yml, WAREHOUSE_UPLOADS_HOST_PATH_DEV).
# Docker prod/test: bind-mount в /app/uploads (docker-compose.prod.yml / docker-compose.test.yml).
# Путь на хосте по умолчанию: /var/www/app-prod/uploads и /var/www/app-test/uploads; WAREHOUSE_UPLOADS_HOST_PATH_PROD / _TEST.
# Переопределение пути внутри процесса (редко нужно, если не меняете mount):
# WAREHOUSE_UPLOADS_DIR=/app/uploads
# Синк FBS-заказов маркетплейсов (Ozon/WB); 0 — выключить. По умолчанию 1.
# MP_SCHEDULER=1
# Интервал polling'а заказов, сек (минимум 30). По умолчанию 120.
# MP_SYNC_INTERVAL_SECONDS=120
# Расчётный SLA сборки WB, часов (WB не отдаёт дедлайн сборки в API). По умолчанию 24.
# MP_WB_SLA_HOURS=24
# Авто-перевод отгрузок «Ожидание упаковки» → «Подготовка» по готовности остатка; 0 — выключить. По умолчанию 1.
# DISPATCH_AUTOPROMOTE_SCHEDULER=1
