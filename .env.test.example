# cp .env.test.example .env.test
# Имя БД должно совпадать с POSTGRES_DB в docker-compose.test.yml.
# Пароль в DATABASE_URL должен совпадать с POSTGRES_PASSWORD в compose (по умолчанию postgres).
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/app_test
VITE_API_BASE_URL=/api
# Версия для GET /version: deploy.sh подставляет git describe; переопределение: APP_VERSION=...
# APP_ENV=test
