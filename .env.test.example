# cp .env.test.example .env.test
# Имя БД должно совпадать с POSTGRES_DB в docker-compose.test.yml.
# Штатный деплой (GitHub Actions) пишет POSTGRES_PASSWORD из секрета POSTGRES_PASSWORD_TEST и
# синхронизирует пароль в DATABASE_URL (scripts/ci-normalize-database-url-test.py).
# Пароль в DATABASE_URL в секрете может отличаться — на сервере будет заменён на POSTGRES_PASSWORD_TEST.
# ВАЖНО: хост в URL — только **db** (имя сервиса в compose), не container_name (wms_prod_db / wms_test_db).
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/app_test
VITE_API_BASE_URL=/api
# Минимум 32 символа (backend/config.py). В CI — секрет JWT_SECRET.
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# Версия для GET /version: deploy.sh подставляет git describe; переопределение: APP_VERSION=...
# APP_ENV=test
