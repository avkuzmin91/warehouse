# Конфигурация резервного копирования WMS.
# Скопируйте на сервере в /etc/wms-backup.env и при необходимости отредактируйте.
# Файл читают wms-backup.sh и wms-restore.sh. Значения по умолчанию рассчитаны на prod.
#
#   sudo cp /var/www/app-prod/scripts/backup/wms-backup.env.example /etc/wms-backup.env
#   sudo chmod 600 /etc/wms-backup.env

# Окружение: prod | test (определяет имена контейнеров и путь приложения по умолчанию)
WMS_ENV=prod

# Каталог приложения на сервере (где docker-compose.prod.yml и uploads/)
APP_DIR=/var/www/app-prod

# Имена контейнеров (по умолчанию wms_${WMS_ENV}_db / wms_${WMS_ENV}_backend)
DB_CONTAINER=wms_prod_db
BACKEND_CONTAINER=wms_prod_backend

# Параметры БД (внутри контейнера postgres подключение по local-сокету без пароля)
DB_NAME=app
DB_USER=postgres

# Каталог с файлами пользователей (фото товаров, import staging)
UPLOADS_DIR=/var/www/app-prod/uploads

# Куда складывать бэкапы и сколько суток хранить
BACKUP_ROOT=/var/backups/wms
RETENTION_DAYS=14

# Исходный код:
#   tree   — архив развёрнутого на сервере дерева (без .git, без auth; всегда работает)
#   mirror — полное зеркало git-истории (git clone --mirror); нужен REPO_URL с доступом
SOURCE_MODE=tree
# Для SOURCE_MODE=mirror укажите URL с доступом на чтение, например:
#   REPO_URL=https://<TOKEN>@github.com/avkuzmin91/warehouse.git
#   REPO_URL=git@github.com:avkuzmin91/warehouse.git   (нужен SSH deploy key на сервере)
REPO_URL=

# Таймзона для имён файлов и меток в логе (cron сам запускается в 03:00 МСК)
WMS_TZ=Europe/Moscow

# (Опционально) SSH-пользователь с доступом на ЧТЕНИЕ бэкапов (через POSIX ACL).
# По умолчанию берётся из репозитория (scripts/backup/wms-backup.defaults.env, сейчас alex)
# и приезжает через CI/CD. Раскомментируйте, только чтобы ПЕРЕОПРЕДЕЛИТЬ для этого сервера.
#BACKUP_READ_USER=alex

# (Опционально) команда отправки бэкапа за пределы сервера. Выполняется как есть;
# доступны переменные $BACKUP_ROOT и $WMS_BACKUP_DATE. Пример с rclone (S3/облако):
#   OFFSITE_CMD='rclone copy --max-age 25h "$BACKUP_ROOT" s3:wms-backups'
OFFSITE_CMD=
