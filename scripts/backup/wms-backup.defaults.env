# Репозиторные значения по умолчанию для бэкапа — деплоятся через CI/CD вместе со скриптом.
# Только НЕ секретные параметры. Секреты и оверрайды для конкретного сервера — в /etc/wms-backup.env
# (он имеет приоритет: синтаксис := ниже заполняет только то, что не задано/пусто в /etc).

# SSH-пользователь с доступом на ЧТЕНИЕ бэкапов (ACL поддерживается на каждом прогоне wms-backup.sh).
: "${BACKUP_READ_USER:=alex}"
