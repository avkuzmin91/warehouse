# Локальные секреты
.env
.env.dev
.env.test
.env.prod
.env.deploy.staging
backend/.env

# Дубликат у корня репозитория (в compose используется nginx/nginx.conf)
/nginx.conf

# Локальные файлы БД (проект на PostgreSQL)
*.db

# Node
node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# Загруженные пользователями файлы
backend/uploads/
# Docker dev: том из корня репозитория (docker-compose.dev.yml)
/uploads/

# Временные файлы разработки
tmp/
# Скриншоты эмулятора (могут содержать логины/пароли — не коммитим)
.emu-*.png

# Claude Code: локальный список разрешений (личный, машинно-зависимый)
