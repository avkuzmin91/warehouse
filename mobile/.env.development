# Браузерная разработка ходит через Vite-прокси на относительный /api.
# Цель прокси можно переопределить (по умолчанию http://127.0.0.1:8000):
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Нативная сборка (Android) требует абсолютный URL backend, например:
# VITE_API_BASE_URL=https://api.example.com
